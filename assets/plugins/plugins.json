{
  "manifest": 1,
  "name": "hledger-anywhere plugins",
  "themes": [
    {
      "name": "gruvbox",
      "colors": {
        "background": "#282828",
        "foreground": "#ebdbb2",
        "cursor": "#fe8019",
        "accent": "#fabd2f",
        "dim": "#a89984"
      }
    },
    {
      "name": "midnight",
      "colors": {
        "background": "#0b1021",
        "foreground": "#c9d1d9",
        "cursor": "#7aa2f7",
        "accent": "#7aa2f7",
        "dim": "#8b95a5"
      }
    },
    {
      "name": "gruvbox-light",
      "colors": {
        "background": "#fbf1c7",
        "foreground": "#3c3836",
        "cursor": "#af3a03",
        "accent": "#8f5a00",
        "dim": "#6b5f55"
      }
    }
  ],
  "plugins": [
    {
      "name": "chart",
      "group": "Reports",
      "summary": "open a chart of hledger's numbers in a window",
      "completes": [
        "spending",
        "income",
        "cashflow",
        "networth",
        "balances",
        "payees",
        "stacked",
        "multiples",
        "calendar",
        "top",
        "shares",
        "treemap",
        "sankey",
        "waterfall",
        "weekly",
        "monthly",
        "quarterly",
        "yearly",
        "daily",
        "this",
        "last",
        "since",
        "expenses"
      ],
      "module": "./chart.js",
      "usage": "chart [question] [account] [when] [how often]",
      "help": "Opens a chart of hledger's own numbers in a window of its own. Name a question, an account, or both in either order, and say when and how often in words: chart food 2024 weekly. Anything that starts with a dash goes to hledger as it is. Under each chart are related charts to follow, and the numbers as a table.",
      "sections": [
        {
          "title": "Over time",
          "rows": [
            [
              "chart",
              "spending by account, month by month; the same as chart spending"
            ],
            [
              "chart income",
              "what came in, month by month"
            ],
            [
              "chart cashflow",
              "income against expenses, month by month"
            ],
            [
              "chart networth",
              "assets and liabilities as one running total"
            ],
            [
              "chart balances",
              "every account, at the end of each month"
            ],
            [
              "chart payees",
              "spending by payee, month by month"
            ],
            [
              "chart stacked [account]",
              "categories stacked month by month"
            ],
            [
              "chart multiples",
              "a small line per account, largest first"
            ],
            [
              "chart calendar",
              "a square per day, darker for more spending"
            ]
          ]
        },
        {
          "title": "Where it went",
          "rows": [
            [
              "chart top [account]",
              "accounts ranked, largest first"
            ],
            [
              "chart shares [account]",
              "each account's share, as a doughnut"
            ],
            [
              "chart treemap [account]",
              "the account tree, area by balance"
            ],
            [
              "chart sankey",
              "income flowing into spending and savings"
            ],
            [
              "chart waterfall",
              "income, a step down per category, then net"
            ]
          ]
        },
        {
          "title": "Anything else",
          "rows": [
            [
              "chart <account>",
              "that account, month by month; chart food matches expenses:food"
            ],
            [
              "chart balance <args>",
              "any balance report, as written; also bs, is and cf"
            ]
          ]
        },
        {
          "title": "When, and how often",
          "rows": [
            [
              "2024, 2024-03, 2024q1",
              "a year, a month, a quarter"
            ],
            [
              "this month, last year",
              "also week and quarter; today, yesterday"
            ],
            [
              "since 2024-06",
              "from then on; until 2024-06 for up to then"
            ],
            [
              "2023 to 2024",
              "a range of dates"
            ],
            [
              "weekly, monthly",
              "also daily, quarterly, yearly; months are the default"
            ]
          ]
        },
        {
          "title": "In the window",
          "rows": [
            [
              "hover, Tab",
              "a mark's numbers"
            ],
            [
              "click, Enter",
              "chart that account on its own"
            ],
            [
              "Also:",
              "related charts under each one, a click away"
            ],
            [
              "Esc",
              "back to the chart before"
            ],
            [
              "legend entry",
              "click to hide or show that series"
            ],
            [
              "scroll, + -",
              "zoom through time; drag to pan"
            ],
            [
              "0, double-click",
              "reset the zoom"
            ],
            [
              "left, right",
              "step through the periods"
            ],
            [
              "s, p",
              "save the chart as SVG, or as PNG"
            ]
          ]
        }
      ],
      "examples": [
        [
          "chart sankey 2024",
          "where 2024's income went"
        ],
        [
          "chart food weekly",
          "food spending, week by week"
        ],
        [
          "chart income last year quarterly",
          "last year's income, by quarter"
        ],
        [
          "chart expenses:food treemap",
          "inside one category"
        ]
      ]
    },
    {
      "name": "edit",
      "group": "Files",
      "summary": "edit a loaded journal in a window",
      "completes": [],
      "module": "./edit.js",
      "usage": "edit [path]",
      "help": "Opens a file in an editor window, with Ctrl+S or Cmd+S writing it back to disk. With no argument it edits the journal hledger is reading. Only files from an open folder can be written: everything else opens read-only, and the save says so. If the file changed on disk since it was opened, the save is refused rather than overwriting the change.",
      "sections": [
        {
          "title": "In the window",
          "rows": [
            [
              "Ctrl+S, Cmd+S",
              "save the file back to disk, if it came from an open folder"
            ]
          ]
        }
      ],
      "examples": [
        [
          "edit",
          "the journal hledger is reading"
        ],
        [
          "edit 2024.journal",
          "another file from the open folder"
        ]
      ]
    }
  ]
}
