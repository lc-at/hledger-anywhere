# Build output
/dist
/target

# Scratch output from verifying the release build without clobbering /dist
/dist-release

# Cabal build output for the hledger wasm build
/dist-newstyle

# Locally installed toolchain (trunk, ghc-wasm-meta)
/.tools

# Alternative cargo home/target used when the shared target directory is busy or
# the default ~/.cargo is not writable. A build cache, never source.
/.cargo-home

# Pinned upstream sources and locally built wasm artifacts
/vendor
/artifacts

# assets/wasm/hledger.wasm IS committed. hledger.wasm is the product: the app is a
# terminal in front of it, and a build that cannot fetch it has nothing to run.
# Engine builds are rare (one per hledger version), and it is verified against the
# SHA-256 in wasm.lock on every build, so the 13 MB is worth not depending on a
# network. See wasm.lock for how to refresh it.

.DS_Store
